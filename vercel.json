{
  "version": 2,
  "name": "smartdoc",
  "buildCommand": "cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "cd api && npm install",
  "framework": null,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "routes": [
    { "src": "/api/health", "dest": "/api/health.js" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.js" },
    { "src": "/api/auth/register", "dest": "/api/auth/register.js" },
    { "src": "/api/templates", "dest": "/api/templates/index.js" },
    { "src": "/api/csv", "dest": "/api/csv.js" },
    { "src": "/api/preview", "dest": "/api/preview.js" },
    { "src": "/(.*)", "dest": "/client/dist/$1" }
  ],
  "env": {
    "VITE_API_URL": ""
  }
}
